# ─── App / API ───────────────────────────────────────────────────
# Required. Use sqlite:///./airfare_index.db for local dev without PostgreSQL.
DATABASE_URL=postgresql+asyncpg://airfare:airfare@localhost:5432/airfare_index
DATABASE_URL_SYNC=postgresql+psycopg2://airfare:airfare@localhost:5432/airfare_index

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Kafka ───────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_RAW=airfare.raw
KAFKA_TOPIC_NORMALIZED=airfare.normalized
KAFKA_TOPIC_VALIDATED=airfare.validated
KAFKA_TOPIC_ANOMALY=airfare.anomaly
KAFKA_TOPIC_INDEX=airfare.index
KAFKA_TOPIC_DEAD_LETTER=airfare.dead-letter
KAFKA_CONSUMER_GROUP=airfare-processor

# ─── S3 / MinIO ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=airfare-raw
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# ─── Authentication ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION_USE_256_BIT_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: Keycloak / OIDC integration (replace JWT if configured)
# OIDC_ISSUER=https://auth.example.com/realms/airfare
# OIDC_CLIENT_ID=airfare-api
# OIDC_CLIENT_SECRET=CHANGE_THIS

# ─── API ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=30

# ─── Collection ──────────────────────────────────────────────────
COLLECTION_USE_DEMO_ADAPTER=true
COLLECTION_DEMO_SEED=42
COLLECTION_BOOKING_WINDOWS=1,7,15,30,45

# ─── Index Engine ────────────────────────────────────────────────
INDEX_METHODOLOGY_VERSION=v1.0
INDEX_BASE_PERIOD_START=2024-01-01
INDEX_BASE_PERIOD_END=2024-01-31
INDEX_CONFIDENCE_HIGH_THRESHOLD=0.95
INDEX_CONFIDENCE_MEDIUM_THRESHOLD=0.80
INDEX_MIN_OBSERVATIONS_PER_ROUTE=3

# ─── Observability ───────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
